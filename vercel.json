{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/biosafety", "destination": "/docs/biosafety.html" },
    { "source": "/styles.css", "destination": "/docs/styles.css" },
    { "source": "/biosafety.js", "destination": "/docs/biosafety.js" },
    { "source": "/assets/(.*)", "destination": "/docs/assets/$1" }
  ]
}
